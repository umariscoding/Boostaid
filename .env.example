# Postgres connection string (Neon, Supabase, local Docker, ...)
DATABASE_URL=postgres://postgres:dev@localhost:54329/boostaid

# Random string used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Logins live in the database (users table), not in environment variables.
# Create one with:  npm run user:create -- you@example.com --name "Your Name"

# --- Gift Aid recovery, invoices and the admin page -------------------------------------------------
# The site's public address, used for the links in donor emails (e.g. https://app.boostaid.co.uk)
APP_URL=http://localhost:3000

# Email (Postmark). Until these are set, nothing is emailed: the app says so and shows the donor links so the form can be tried.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=

# Protects the daily job (reminders after 14 days, "No response" 14 days later). Vercel sends it as a Bearer token.
# With no value set nobody can call the job. Generate with: openssl rand -hex 32
CRON_SECRET=

# Printed on invoices (all optional)
INVOICE_BUSINESS_NAME=BoostAid
INVOICE_BUSINESS_ADDRESS=
INVOICE_BANK_DETAILS=
INVOICE_VAT_NUMBER=

# The admin page is only for logins with the admin role. Give one with:
#   npm run user:role -- owner@example.com admin
