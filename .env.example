# Postgres connection string (Neon, Supabase, local Docker, ...)
DATABASE_URL=postgres://postgres:dev@localhost:54329/boostaid

# Single login for the dashboard
ADMIN_EMAIL=admin@boostaid.com
ADMIN_PASSWORD=change-me

# Random string used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
